# Weathero API — copy to .env
DATABASE_URL=postgresql+psycopg://weathero:weathero@localhost:5435/weathero
CORS_ORIGINS=http://localhost:5173

# Slice V3b — set to production to disable /docs and /redoc
ENV=development

# Slice B — OPENWEATHER_API_KEY is required for live weather (empty → 503)
OPENWEATHER_API_KEY=
OPEN_METEO_ENABLED=1
